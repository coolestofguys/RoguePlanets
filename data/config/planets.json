{
	# Nocturnal World: a darkened variant of the vanilla Terran look.
	# To change how dark it is, edit planetColor / cloudColor / atmosphereColor / iconColor (lower = darker).
	"nocturnal":{
		"name":"Nocturnal",
		"tags":["codex_unlockable"], # codex entry stays locked until the player finds one
		"descriptionId":"roguePlanets_nocturnal", # row in data/strings/descriptions.csv
		"tilt":20, # left-right (>0 tilts to the left)
		"pitch":30, # towards-away from the viewer (>0 pitches towards)
		"rotation":-3, # degrees/second
		"planetColor":[255,255,255,255], # texture is already dark; lower these numbers to darken further
		"atmosphereThickness":0.25, # as fraction of radius.  Set to 0 for no atmosphere
		"atmosphereThicknessMin":40, #  minimum thickness in pixels
		"atmosphereColor":[48,64,112,100],
		"texture":"graphics/planets/nocturnal.jpg",
		"icon":"graphics/warroom/icon_planet.png",
		"iconColor":[100,115,160,255],
		"isStar":false,
		"lightPosition":[4,-1,8], # in planet radii.  Not used for stars.  z > 0 is above the playing field.
		"cloudTexture":"graphics/planets/clouds_banded01.png", # omit for no cloud layer
		"cloudColor":[88,92,112,225],
		"cloudRotation":-5, # degrees/second, optional
	},

