	# Sub-Brown Dwarf: a super-Jupiter on the edge of being a star, glowing magenta from internal heat under iron clouds.
	# Spawns through normal generation like a gas giant. The glow layer stays lit on the night side too.
	"subbrown_dwarf":{
		"name":"Sub-Brown Dwarf",
		"tags":["codex_unlockable"], # codex entry stays locked until the player finds one
		"descriptionId":"subbrown_dwarf", # row in data/strings/descriptions.csv
		"tilt":-8,
		"pitch":-15,
		"rotation":-2, # degrees/second
		"planetColor":[255,255,255,255],
		"atmosphereThickness":0.2,
		"atmosphereThicknessMin":62,
